# =============================================================================
# ai-tutor-v1 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secret keys in frontend .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit Cloud WebSocket URL
# Required. Get it from: https://cloud.livekit.io → your project → Settings
# Example: wss://my-project.livekit.cloud
# -----------------------------------------------------------------------------
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# -----------------------------------------------------------------------------
# Backend token server base URL
# Leave EMPTY to use the Vite proxy (/api → localhost:8000) in development.
# Set to your production backend URL when deploying.
# Example: https://api.yourapp.com
# -----------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000
